FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY src ./src
COPY services/vehicle-service/proto ./services/vehicle-service/proto
COPY services/customer-service/proto ./services/customer-service/proto
COPY services/rental-service/proto ./services/rental-service/proto

EXPOSE 5000
CMD ["npm", "run", "start"]